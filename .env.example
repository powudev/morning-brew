# Copy to .env.local (Next.js) and .dev.vars (Pages Functions) and fill in local values.
# Never commit real values.

# Public site URL (sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (safe to expose: access is enforced by RLS)
# Local values: API URL and anon key from `supabase status`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public)
# Test key that always passes: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Server only (Cloudflare Pages env / .dev.vars). Never prefix with NEXT_PUBLIC_ ----
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
