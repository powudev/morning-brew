# 複製成 .env.local(前端)與 .dev.vars(Pages Function 本機),填入本機值。不要提交真實值。

# 網站正式網址(sitemap、canonical、OG 用;非機密)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase(前端可公開;權限由 RLS 控制)
# 本機值:`supabase status` 的 API URL 與 anon key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key(前端可公開)
# 本機/測試可用 Cloudflare 官方測試金鑰 1x00000000000000000000AA(永遠通過);E2E 由 `pnpm build:e2e` 自動帶入
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- 以下僅限 server 端(Cloudflare Pages 環境變數 / .dev.vars),絕不可加 NEXT_PUBLIC_ 前綴 ----
SUPABASE_SERVICE_ROLE_KEY=
# 測試 secret:1x0000000000000000000000000000000AA(通過)/ 2x0000000000000000000000000000000AA(失敗)
TURNSTILE_SECRET_KEY=
